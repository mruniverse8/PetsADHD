{
  "name": "petsadhd",
  "displayName": "PetsADHD",
  "description": "Pixel pets and arcade games in a dockable VS Code terminal panel, with Tetris, shared-keyboard duels and Space Invaders.",
  "version": "0.3.4",
  "publisher": "mruniverse8",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pets",
    "tetris",
    "arcade",
    "space-invaders"
  ],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mruniverse8/PetsADHD.git",
    "directory": "vscode"
  },
  "contributes": {
    "commands": [
      {
        "command": "petsadhd.open",
        "title": "Open / Resume Arcade",
        "category": "PetsADHD"
      },
      {
        "command": "petsadhd.play",
        "title": "Open / Resume Game",
        "category": "PetsADHD"
      },
      {
        "command": "petsadhd.tetris",
        "title": "Play Tetris",
        "category": "PetsADHD"
      },
      {
        "command": "petsadhd.duel",
        "title": "Play Competitive Tetris (2 Players)",
        "category": "PetsADHD"
      },
      {
        "command": "petsadhd.invaders",
        "title": "Play Space Invaders",
        "category": "PetsADHD"
      },
      {
        "command": "petsadhd.pets",
        "title": "Show Tiny Pets",
        "category": "PetsADHD"
      },
      {
        "command": "petsadhd.position",
        "title": "Move Game Panel",
        "category": "PetsADHD"
      }
    ],
    "configuration": {
      "title": "PetsADHD",
      "properties": {
        "petsadhd.music.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the optional game soundtrack. Requires yt-dlp and ffplay."
        },
        "petsadhd.music.url": {
          "type": "string",
          "default": "https://www.youtube.com/watch?v=z0FRc-51_V4",
          "description": "YouTube soundtrack URL."
        },
        "petsadhd.music.volume": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "maximum": 100,
          "description": "Music volume."
        },
        "petsadhd.music.extractor": {
          "type": "string",
          "default": "",
          "description": "Optional path to yt-dlp."
        },
        "petsadhd.tetris.speed": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 8,
          "description": "Initial Tetris speed multiplier."
        },
        "petsadhd.tetris.musicUrl": {
          "type": "string",
          "default": "https://www.youtube.com/watch?v=oor2uIqys8M",
          "description": "Default soundtrack for Tetris and competitive Tetris."
        },
        "petsadhd.panel.position": {
          "type": "string",
          "enum": [
            "bottom-right",
            "bottom",
            "left",
            "right"
          ],
          "default": "bottom-right",
          "description": "Dock position for the terminal. Bottom-right uses the bottom panel with right alignment; moves the entire VS Code panel."
        },
        "petsadhd.panel.autoSize": {
          "type": "boolean",
          "default": true,
          "description": "Fit the panel when opening or switching modes: about 8 rows for pets, expanded for games, within available space."
        },
        "petsadhd.panel.columns": {
          "type": "integer",
          "default": 72,
          "minimum": 28,
          "maximum": 160,
          "description": "Preferred terminal width when opening in the left or right panel. Larger panels are preserved."
        },
        "petsadhd.panel.rows": {
          "type": "integer",
          "default": 28,
          "minimum": 16,
          "maximum": 60,
          "description": "Preferred terminal height when opening in the bottom panel. Larger panels are preserved."
        },
        "petsadhd.pets.style": {
          "type": "string",
          "enum": [
            "line",
            "pixels"
          ],
          "default": "line",
          "description": "Always-tiny pets: one-line ASCII companions or fixed three-line pixel sprites. Neither style grows with the panel."
        }
      }
    },
    "keybindings": [
      {
        "command": "petsadhd.pets",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "petsadhd.play",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --out ../dist/PetsADHD-0.3.4.vsix --baseContentUrl https://github.com/mruniverse8/PetsADHD/blob/main/vscode/ --baseImagesUrl https://raw.githubusercontent.com/mruniverse8/PetsADHD/main/vscode/"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Games and pets work in restricted mode; external audio processes require a trusted workspace."
    }
  }
}
